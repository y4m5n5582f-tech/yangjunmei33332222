<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
      background-color:#0f172a;
      display:flex;
      flex-direction:column;
      align-items:center;
      padding-top:20px;
      font-family:"Microsoft Yahei",sans-serif;
      color:#fff;
}

#gameInfo{
     font-size:20px;
     margin-bottom:10px;
}

canvas{
border:3px solid #38bdf8;
border-radius:8px;
background-color:#1e293b;
}
</style>
</head>
<body>

<div id="gameInfo">Уровень 1 | Очки:0 | ← → Двигаться | Пробел Прыжок</div>
<canvas id="gameCanvas" width="800" height="500"></canvas>

<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext("2d");

// ================== Аудио ==================
let audioCtx;
function initAudio(){
  if(!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
}

function playJumpSound(){
  initAudio();
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.connect(gain);
  gain.connect(audioCtx.destination);
  osc.type = "square";
  osc.frequency.setValueAtTime(300, audioCtx.currentTime);
  osc.frequency.exponentialRampToValueAtTime(450, audioCtx.currentTime + 0.1);
  gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
  gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.12);
  osc.start();
  osc.stop(audioCtx.currentTime + 0.12);
}

function playCoinSound(){
  initAudio();
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.connect(gain);
  gain.connect(audioCtx.destination);
  osc.type = "sine";
  osc.frequency.setValueAtTime(600, audioCtx.currentTime);
  osc.frequency.exponentialRampToValueAtTime(900, audioCtx.currentTime + 0.12);
  gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
  gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.15);
  osc.start();
  osc.stop(audioCtx.currentTime + 0.15);
}

function playDieSound(){
  initAudio();
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.connect(gain);
  gain.connect(audioCtx.destination);
  osc.type = "sawtooth";
  osc.frequency.setValueAtTime(220, audioCtx.currentTime);
  osc.frequency.exponentialRampToValueAtTime(80, audioCtx.currentTime + 0.3);
  gain.gain.setValueAtTime(0.18, audioCtx.currentTime);
  gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.3);
  osc.start();
  osc.stop(audioCtx.currentTime + 0.3);
}

function playWinSound(){
  initAudio();
  const notes = [523, 659, 784, 1047];
  notes.forEach((freq,i)=>{
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.type = "sine";
    osc.frequency.value = freq;
    const t = audioCtx.currentTime + i*0.18;
    gain.gain.setValueAtTime(0.15, t);
    gain.gain.exponentialRampToValueAtTime(0.001, t+0.17);
    osc.start(t);
    osc.stop(t+0.17);
  })
}

// ================== Данные уровней ==================
const levels = [
  // Уровень 1
  {
    platforms: [
      {x:0,   y:460, w:200, h:20},
      {x:250, y:380, w:150, h:20},
      {x:450, y:300, w:150, h:20},
      {x:200, y:220, w:150, h:20},
      {x:420, y:140, w:180, h:20},
      {x:650, y:220, w:130, h:20},
    ],
    movingPlatforms: [
      {x:300, y:280, w:100, h:20, minX:250, maxX:450, speed:2, dir:1}
    ],
    spikes: [
      {x: 120, y:440, w:60, h:20},
      {x: 480, y:280, w:40, h:20}
    ],
    coins: [
      {x:80,  y:430, get:false},
      {x:310, y:350, get:false},
      {x:510, y:270, get:false},
      {x:260, y:190, get:false},
      {x:490, y:110, get:false},
      {x:700, y:190, get:false},
    ],
    flag: {x:720, y:170, w:30, h:50},
    playerStartX:50,
    playerStartY:300
  },
  // Уровень 2 (сложнее)
  {
    platforms: [
      {x:0,   y:460, w:120, h:20},
      {x:180, y:400, w:100, h:20},
      {x:330, y:340, w:100, h:20},
      {x:150, y:260, w:100, h:20},
      {x:320, y:190, w:120, h:20},
      {x:500, y:260, w:100, h:20},
      {x:650, y:180, w:140, h:20},
    ],
    movingPlatforms: [
      {x:220, y:320, w:80, h:20, minX:180, maxX:320, speed:2.5, dir:1},
      {x:480, y:140, w:80, h:20, minX:440, maxX:580, speed:-2, dir:-1}
    ],
    spikes: [
      {x: 80, y:440, w:35, h:20},
      {x: 360, y:320, w:35, h:20},
      {x: 530, y:240, w:35, h:20}
    ],
    coins: [
      {x:60,  y:430, get:false},
      {x:220, y:370, get:false},
      {x:370, y:310, get:false},
      {x:190, y:230, get:false},
      {x:370, y:160, get:false},
      {x:540, y:230, get:false},
      {x:710, y:150, get:false},
    ],
    flag: {x:730, y:130, w:30, h:50},
    playerStartX:30,
    playerStartY:400
  }
]

let currentLevelIndex = 0;
let level;

const player = {
      x: 50,
      y: 300,
      w: 30,
      h: 40,
      vx: 0,
      vy: 0,
      speed: 6,
      jumpPower: -14,
      gravity: 0.6,
      onGround: false,
      state: "idle",
      frame: 0,
      animTimer: 0,
      facing: 1,
      dieTimer: 0
};

let score = 0;

const keys = {
left: false,
right: false,
jump: false,
};

function loadLevel(idx){
  currentLevelIndex = idx;
  level = JSON.parse(JSON.stringify(levels[idx]));
  player.x = level.playerStartX;
  player.y = level.playerStartY;
  player.vx = 0;
  player.vy = 0;
  player.state = "idle";
  player.frame = 0;
  player.dieTimer = 0;
  updateInfoText();
}

function updateInfoText(){
  document.getElementById("gameInfo").innerText = `Уровень ${currentLevelIndex+1} | Очки:${score} | ← → Двигаться | Пробел Прыжок`;
}

function resetGame(){
  score = 0;
  loadLevel(0);
}

function nextLevel(){
  if(currentLevelIndex +1 < levels.length){
    loadLevel(currentLevelIndex + 1);
  }else{
    alert("🎉 Вы прошли всю игру!");
    resetGame();
  }
}

function allCoinsCollected(){
  return level.coins.every(c=>c.get);
}

// ================== Отрисовка игрока ==================
function drawPlayer(){
  const px = player.x;
  const py = player.y;
  const pw = player.w;
  const ph = player.h;

  let bodyColor = "#f43f5e";
  if(player.state === "jump") bodyColor = "#fb7185";
  if(player.state === "die"){
    bodyColor = Math.floor(player.dieTimer / 4) % 2 === 0 ? "#ef4444" : "#fca5a5";
  }

  ctx.fillStyle = bodyColor;
  ctx.fillRect(px + 6, py + 8, pw - 12, ph - 18);
  ctx.fillRect(px + 8, py, pw - 16, 12);

  ctx.fillStyle = "#fff";
  if(player.facing === 1){
    ctx.fillRect(px + 14, py + 3, 3, 3);
  } else {
    ctx.fillRect(px + 13, py + 3, 3, 3);
  }

  ctx.fillStyle = bodyColor;
  if(player.state === "jump"){
    ctx.fillRect(px + 7, py + ph - 10, 6, 10);
    ctx.fillRect(px + pw - 13, py + ph - 10, 6, 10);
  } else if(player.state === "run"){
    switch(player.frame){
      case 0:
        ctx.fillRect(px + 7, py + ph - 10, 6, 10);
        ctx.fillRect(px + pw - 13, py + ph - 6, 6, 6);
        break;
      case 1:
        ctx.fillRect(px + 7, py + ph - 6, 6, 6);
        ctx.fillRect(px + pw - 13, py + ph - 10, 6, 10);
        break;
      case 2:
        ctx.fillRect(px + 7, py + ph - 10, 6, 10);
        ctx.fillRect(px + pw - 13, py + ph - 6, 6, 6);
        break;
      case 3:
        ctx.fillRect(px + 7, py + ph - 6, 6, 6);
        ctx.fillRect(px + pw - 13, py + ph - 10, 6, 10);
        break;
    }
  } else {
    ctx.fillRect(px + 7, py + ph - 10, 6, 10);
    ctx.fillRect(px + pw - 13, py + ph - 10, 6, 10);
  }
}

// ================== Игровой цикл ==================
function gameLoop(){
    ctx.clearRect(0,0, canvas.width, canvas.height);

    level.movingPlatforms.forEach(p=>{
      p.x += p.speed * p.dir
      if(p.x <= p.minX || p.x + p.w >= p.maxX){
        p.dir *= -1
      }
    })

    if(keys.left){
      player.vx = -player.speed;
      player.facing = -1;
    }
    else if(keys.right){
      player.vx = player.speed;
      player.facing = 1;
    }
    else player.vx = 0;

    if(player.state !== "die"){
      if(!player.onGround){
        player.state = "jump";
      } else if(Math.abs(player.vx) > 0){
        player.state = "run";
      } else {
        player.state = "idle";
      }
    }

    if(player.state === "run"){
      player.animTimer++;
      if(player.animTimer >= 6){
        player.frame = (player.frame + 1) % 4;
        player.animTimer = 0;
      }
    } else {
      player.frame = 0;
    }

    if(player.state === "die"){
      player.dieTimer++;
    }

    if(keys.jump && player.onGround && player.state !== "die"){
        player.vy = player.jumpPower;
        player.onGround = false;
        player.state = "jump";
        playJumpSound();
    }

    if(player.state !== "die"){
      player.vy += player.gravity;
      player.x += player.vx;
      player.y += player.vy;
    }

    if(player.x < 0) player.x = 0
    if(player.x + player.w > canvas.width) player.x = canvas.width - player.w;

    if(player.y > canvas.height && player.state !== "die"){
      player.state = "die";
      playDieSound();
      setTimeout(()=>{
        loadLevel(currentLevelIndex);
      }, 500);
    }

    player.onGround = false;

    for(let p of level.platforms){
        if(
        player.x + player.w > p.x &&
        player.x < p.x + p.w &&
        player.y + player.h >= p.y &&
        player.y + player.h <= p.y + 18 &&
        player.vy >= 0
        ){
            player.y = p.y - player.h;
            player.vy = 0;
            player.onGround = true;
        }
    }

    for(let p of level.movingPlatforms){
        if(
        player.x + player.w > p.x &&
        player.x < p.x + p.w &&
        player.y + player.h >= p.y &&
        player.y + player.h <= p.y + 18 &&
        player.vy >= 0
        ){
            player.y = p.y - player.h;
            player.vy = 0;
            player.onGround = true;
            player.x += p.speed * p.dir
        }
    }

    for(let s of level.spikes){
      if(
        player.x + player.w > s.x &&
        player.x < s.x + s.w &&
        player.y + player.h > s.y &&
        player.state !== "die"
      ){
        player.state = "die";
        playDieSound();
        setTimeout(()=>{
          loadLevel(currentLevelIndex);
        }, 500);
      }
    }

    for(let c of level.coins){
        if(!c.get){
            ctx.fillStyle="#facc15";
            ctx.beginPath();
            ctx.arc(c.x,c.y,10,0,Math.PI*2);
            ctx.fill();

            if(
            player.x < c.x +10 &&
            player.x + player.w > c.x -10 &&
            player.y < c.y +10 &&
            player.y + player.h > c.y -10
            ){
                c.get = true;
                score +=10;
                playCoinSound();
                updateInfoText();
            }
        }
    }

    ctx.fillStyle="#38bdf8";
    for(let p of level.platforms){
        ctx.fillRect(p.x,p.y,p.w,p.h);
    }

    ctx.fillStyle="#a855f7";
    for(let p of level.movingPlatforms){
        ctx.fillRect(p.x,p.y,p.w,p.h);
    }

    ctx.fillStyle="#ef4444";
    level.spikes.forEach(s=>{
      ctx.beginPath();
      ctx.moveTo(s.x, s.y+s.h);
      ctx.lineTo(s.x + s.w/2, s.y);
      ctx.lineTo(s.x + s.w, s.y+s.h);
      ctx.closePath();
      ctx.fill();
    })

    const flag = level.flag;
    ctx.fillStyle="#22c55e";
    ctx.fillRect(flag.x, flag.y, 6, flag.h)
    ctx.beginPath()
    ctx.moveTo(flag.x+6, flag.y)
    ctx.lineTo(flag.x+25, flag.y+12)
    ctx.lineTo(flag.x+6, flag.y+24)
    ctx.closePath()
    ctx.fill()

    if(
      allCoinsCollected() &&
      player.x + player.w > flag.x &&
      player.x < flag.x + flag.w &&
      player.y + player.h > flag.y &&
      player.state !== "die"
    ){
      playWinSound();
      if(currentLevelIndex === levels.length - 1){
        alert("Победа! Вы прошли всю игру!");
        resetGame();
      }else{
        alert("Уровень пройден! Переход на следующий!");
        nextLevel();
      }
    }

    drawPlayer();
    requestAnimationFrame(gameLoop);
}

document.addEventListener("keydown",e=>{
if(e.code=="ArrowLeft") keys.left=true;
if(e.code=="ArrowRight") keys.right=true;
if(e.code=="Space") {
    keys.jump=true;
    e.preventDefault();
}
})
document.addEventListener("keyup",e=>{
if(e.code=="ArrowLeft") keys.left=false;
if(e.code=="ArrowRight") keys.right=false;
if(e.code=="Space") keys.jump=false;
})

loadLevel(0);
gameLoop();
</script>
</body>
</html>
