<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ян Цзюньмэй | Личное портфолио</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            transition: all 0.35s ease;
        }
        :root {
            --cream: #f8f5ef;
            --warm-dark: #4b2428;
            --warm-grey: #7c726c;
            --light-grey: #e9e4dd;
            --gold: #b89b78;
            --white: #ffffff;
        }
        html.dark {
            --cream: #2c2425;
            --warm-dark: #f0e9e3;
            --warm-grey: #b9aca6;
            --light-grey: #44393a;
            --gold: #d4b894;
        }
        *::-webkit-scrollbar {
            width: 6px;
        }
        *::-webkit-scrollbar-thumb {
            background: var(--gold);
            border-radius: 10px;
        }
        body {
            background-color: var(--cream);
            color: var(--warm-dark);
            line-height: 1.75;
            opacity: 0;
            animation: fadeIn 1s ease forwards;
            font-family: 'Segoe UI', system-ui, sans-serif;
        }
        @keyframes fadeIn {
            to { opacity: 1; }
        }
        .hero {
            width: 100%;
            min-height: 82vh;
            background: linear-gradient(rgba(43, 22, 26, 0.45), rgba(43, 22, 26, 0.45)), url('https://images.unsplash.com/photo-1506905925346-21bda4d32862?q=80&w=1920') center/cover no-repeat;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
            text-align: center;
            padding: 2rem;
            position: relative;
            overflow: hidden;
        }
        .hero::after {
            content: "";
            position: absolute;
            width: 70%;
            height: 70%;
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 50%;
            pointer-events: none;
        }
        .hero::before {
            content: "";
            position: absolute;
            width: 55%;
            height: 55%;
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 50%;
            pointer-events: none;
        }
        .hero h1 {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: clamp(2.4rem,6vw,4.2rem);
            font-weight: 400;
            letter-spacing: 2px;
            margin-bottom: 12px;
            z-index: 2;
        }
        .hero-sub {
            font-size: 0.95rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            opacity: 0.85;
            z-index:2;
        }
        header {
            position: sticky;
            top:0;
            width:100%;
            z-index:999;
            background: transparent;
            padding:1.4rem 0;
        }
        .nav-wrap {
            max-width: 1140px;
            margin:0 auto;
            padding:0 2rem;
            display:flex;
            justify-content: space-between;
            align-items:center;
        }
        .logo {
            font-family: Georgia, serif;
            font-size:1.3rem;
            letter-spacing:1px;
            color:#fff;
        }
        html.dark .logo {
            color:var(--warm-dark);
        }
        nav a {
            color:rgba(255,255,255,0.82);
            text-decoration:none;
            margin-left:20px;
            font-size:0.92rem;
            letter-spacing:0.5px;
        }
        html.dark nav a {
            color:var(--warm-grey);
        }
        nav a:hover {
            color:var(--gold);
        }
        #themeBtn {
            border:1px solid rgba(255,255,255,0.25);
            background:transparent;
            color:#fff;
            padding:6px 11px;
            border-radius:99px;
            cursor:pointer;
            margin-left:14px;
        }
        html.dark #themeBtn {
            border:1px solid var(--warm-grey);
            color:var(--warm-dark);
        }
        .container {
            max-width:1140px;
            margin:0 auto;
            padding:0 2rem;
        }
        section {
            margin:7rem 0;
        }
        h2 {
            font-family: Georgia, serif;
            font-size:1.8rem;
            font-weight:400;
            color:var(--warm-dark);
            margin-bottom:2rem;
        }
        .about-card, .skill-card {
            background: var(--white);
            border-radius:14px;
            padding:2.2rem;
            border: 1px solid var(--light-grey);
        }
        html.dark .about-card,
        html.dark .skill-card {
            background: var(--light-grey);
        }
        .about-card p {
            color:var(--warm-grey);
            font-size:1.04rem;
        }
        .project-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(290px,1fr));
            gap:26px;
        }
        .project-card {
            background: var(--white);
            border-radius:14px;
            border: 1px solid var(--light-grey);
            overflow:hidden;
            cursor:pointer;
            transition: transform 0.3s ease, border-color 0.3s ease;
        }
        html.dark .project-card {
            background: var(--light-grey);
        }
        .project-card:hover {
            transform: translateY(-6px);
            border-color: var(--gold);
        }
        .project-img {
            width:100%;
            height:180px;
            object-fit:cover;
            display:block;
        }
        .project-text {
            padding:1.4rem;
        }
        .project-card h3 {
            font-family: Georgia, serif;
            font-size:1.35rem;
            margin-bottom:7px;
            color:var(--warm-dark);
        }
        .project-card p {
            color:var(--warm-grey);
            font-size:0.9rem;
        }
        ul li {
            color:var(--warm-grey);
            margin:10px 0;
            list-style:none;
            position:relative;
            padding-left:18px;
        }
        ul li::before {
            content: "—";
            color:var(--gold);
            position:absolute;
            left:0;
        }
        .overlay {
            position: fixed;
            inset:0;
            background: rgba(26,16,18,0.72);
            display:none;
            align-items:center;
            justify-content:center;
            z-index:1000;
            padding:1rem;
        }
        .modal {
            background: var(--cream);
            border-radius:16px;
            padding:2.6rem;
            max-width:600px;
            width:100%;
            border:1px solid var(--light-grey);
        }
        .modal h3 {
            font-family: Georgia, serif;
            color:var(--warm-dark);
            margin-bottom:1rem;
            font-size:1.5rem;
        }
        .modal p {
            color:var(--warm-grey);
        }
        .close-modal {
            margin-top:1.6rem;
            padding:9px 22px;
            border:none;
            background:var(--gold);
            color:#fff;
            border-radius:99px;
            cursor:pointer;
        }
        .back-top {
            position:fixed;
            bottom:32px;
            right:32px;
            width:46px;
            height:46px;
            border-radius:50%;
            border:none;
            background:var(--gold);
            color:#fff;
            font-size:18px;
            cursor:pointer;
            display:none;
        }
        /* ========== Виджеты стили ========== */
        .widgets-grid{
            display:grid;
            grid-template-columns: repeat(auto-fit, minmax(300px,1fr));
            gap:24px;
        }
        .widget-card{
            background:var(--white);
            border:1px solid var(--light-grey);
            border-radius:14px;
            overflow:hidden;
        }
        html.dark .widget-card{
            background:var(--light-grey);
        }
        .widget-header{
            padding:1rem 1.4rem;
            display:flex;
            justify-content:space-between;
            align-items:center;
            border-bottom:1px solid var(--light-grey);
            min-height:56px;
        }
        .widget-header h4{
            font-family:Georgia,serif;
            font-size:1.15rem;
            color:var(--warm-dark);
            font-weight:normal;
        }
        .toggle-widget{
            background:transparent;
            border:none;
            color:var(--gold);
            font-size:1.2rem;
            cursor:pointer;
            width:44px;
            height:44px;
        }
        .widget-body{
            padding:1.4rem;
            max-height:2000px;
            overflow:hidden;
        }
        .widget-body.collapsed{
            max-height:0;
            padding:0 1.4rem;
        }
        /* Todo список */
        .todo-input-wrap{
            display:flex;
            gap:8px;
            margin-bottom:14px;
        }
        #todoInput{
            flex:1;
            padding:8px 10px;
            border:1px solid var(--light-grey);
            border-radius:8px;
            background:var(--cream);
            color:var(--warm-dark);
            min-height:44px;
        }
        #addTodoBtn, #clearDoneBtn{
            padding:8px 14px;
            background:var(--gold);
            color:white;
            border:none;
            border-radius:8px;
            cursor:pointer;
            min-height:44px;
        }
        #clearDoneBtn{
            background:#947460;
            margin:10px 0;
        }
        .todo-list li{
            display:flex;
            justify-content:space-between;
            align-items:center;
            padding:6px 0;
            border-bottom:1px solid var(--light-grey);
        }
        .todo-text{
            cursor:pointer;
        }
        .todo-done {
            text-decoration: line-through;
            opacity:0.55;
        }
        .todo-del{
            border:none;
            background:transparent;
            color:#c86b6b;
            cursor:pointer;
            font-size:16px;
        }
        /* Цитата */
        .api-quote-text{
            font-style:italic;
            color:var(--warm-grey);
            margin-bottom:8px;
        }
        .api-quote-author{
            text-align:right;
            color:var(--gold);
            font-size:0.9rem;
        }
        #refreshQuote, #refreshPet, #refreshWeather, #refreshRate{
            margin-top:10px;
            border:none;
            background:var(--gold);
            color:white;
            padding:6px 12px;
            border-radius:8px;
            cursor:pointer;
        }
        .pet-img{
            width:100%;
            border-radius:10px;
            object-fit:cover;
            max-height:220px;
        }
        .weather-item, .rate-item{
            padding:4px 0;
            color:var(--warm-grey);
        }
        @media (max-width:640px) {
            .nav-wrap {
                flex-wrap:wrap;
                gap:12px;
            }
            nav a {
                margin-left:7px;
                font-size:0.84rem;
            }
            .hero h1 {
                font-size:2rem;
            }
            section {
                margin:4.5rem 0;
            }
        }
    </style>
</head>
<body>
    <section class="hero">
        <header>
            <div class="nav-wrap">
                <div class="logo">YJM Portfolio</div>
                <nav>
                    <a href="#about">Обо мне</a>
                    <a href="#study">Обучение</a>
                    <a href="#can">Навыки</a>
                    <a href="#projects">Проекты</a>
                    <a href="#widgets">Виджеты</a>
                    <button id="themeBtn">🌓</button>
                </nav>
            </div>
        </header>
        <h1>Портфолио Ян Цзюньмэй</h1>
        <div class="hero-sub">ДИЗАЙН · ВИЗУАЛ · ВЕБ‑РАЗРАБОТКА</div>
    </section>
    <div class="container">
        <section id="about">
            <h2>Обо мне</h2>
            <div class="about-card">
                <p>Привет! Меня зовут Ян Цзюньмэй, я молодой дизайнер из Китая. Я увлекаюсь визуальным искусством, цифровым творчеством и веб‑разработкой.</p>
                <br>
                <p>Я активно изучаю русский язык, видеомонтаж и 3D‑моделирование. У меня есть опыт создания цифровых иллюстраций и трехмерных моделей. В данном портфолио я представляю свои основные творческие работы, особенно проекты по видеомонтажу.</p>
            </div>
        </section>
        <section id="study">
            <h2>Что я изучаю</h2>
            <div class="skill-card">
                <ul>
                    <li>Русский язык (улучшение разговорной и письменной речи)</li>
                    <li>Профессиональный видеомонтаж и цветокоррекция</li>
                    <li>3D‑моделирование и визуализация</li>
                    <li>Адаптивная верстка HTML/CSS</li>
                    <li>Программирование на JavaScript</li>
                    <li>Работа с Git и публикация проектов</li>
                    <li>UI/UX дизайн в Figma</li>
                </ul>
            </div>
        </section>
        <section id="can">
            <h2>Мои навыки</h2>
            <div class="skill-card">
                <ul>
                    <li>Создавать авторские цифровые иллюстрации</li>
                    <li>Разрабатывать качественные 3D‑модели</li>
                    <li>Профессионально монтировать и обрабатывать видео</li>
                    <li>Верстать современные адаптивные сайты</li>
                    <li>Реализовывать интерактивный функционал на JavaScript</li>
                    <li>Разрабатывать дизайнерские прототипы интерфейсов</li>
                </ul>
            </div>
        </section>
        <section id="projects">
            <h2>Мои проекты</h2>
            <div class="project-list">
                <div class="project-card" data-name="Видеомонтаж" data-desc="Мои авторские короткометражные работы: профессиональный монтаж, плавные переходы, цветокоррекция, работа со звуком и атмосферой видео.">
                    <img class="project-img" src="https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?w=600" alt="Видеомонтаж">
                    <div class="project-text">
                        <h3>Видеомонтаж</h3>
                        <p>Творческие видеоработы</p>
                    </div>
                </div>
                <div class="project-card" data-name="3D‑моделирование" data-desc="Трехмерное моделирование объектов и сцен, визуализация, работа с формами, текстурами и композицией.">
                    <img class="project-img" src="https://images.unsplash.com/photo-1633356122544-f134324a6cee?w=600" alt="3D">
                    <div class="project-text">
                        <h3>3D Модели</h3>
                        <p>Объемное моделирование</p>
                    </div>
                </div>
                <div class="project-card" data-name="Цифровые иллюстрации" data-desc="Авторские иллюстрации, художественная графика, работа с цветом, композицией и стилем.">
                    <img class="project-img" src="https://images.unsplash.com/photo-1513364776144-60967b0f800f?w=600" alt="Иллюстрации">
                    <div class="project-text">
                        <h3>Иллюстрации</h3>
                        <p>Цифровое искусство</p>
                    </div>
                </div>
                <div class="project-card" data-name="Личное портфолио" data-desc="Адаптивный современный сайт‑портфолио с интерактивными элементами и адаптацией под мобильные устройства.">
                    <img class="project-img" src="https://images.unsplash.com/photo-1507721999472-8ed4421c4af2?w=600" alt="Веб">
                    <div class="project-text">
                        <h3>Веб‑портфолио</h3>
                        <p>Web‑разработка + дизайн</p>
                    </div>
                </div>
            </div>
        </section>
        <section id="widgets">
            <h2>Интерактивные виджеты</h2>
            <div class="widgets-grid">
                <!-- Список дел -->
                <div class="widget-card" data-widgetkey="todo">
                    <div class="widget-header">
                        <h4>Список дел</h4>
                        <button class="toggle-widget">−</button>
                    </div>
                    <div class="widget-body">
                        <div class="todo-input-wrap">
                            <input id="todoInput" placeholder="Добавить задачу...">
                            <button id="addTodoBtn">+</button>
                        </div>
                        <ul class="todo-list" id="todoList"></ul>
                        <button id="clearDoneBtn">Очистить выполненные</button>
                    </div>
                </div>
                <!-- Случайная цитата -->
                <div class="widget-card" data-widgetkey="quote">
                    <div class="widget-header">
                        <h4>Случайная цитата</h4>
                        <button class="toggle-widget">−</button>
                    </div>
                    <div class="widget-body">
                        <div class="api-quote-text" id="quoteText">Загрузка...</div>
                        <div class="api-quote-author" id="quoteAuthor"></div>
                        <button id="refreshQuote">Обновить цитату</button>
                    </div>
                </div>
                <!-- Случайное фото питомца -->
                <div class="widget-card" data-widgetkey="pet">
                    <div class="widget-header">
                        <h4>Случайное фото питомца</h4>
                        <button class="toggle-widget">−</button>
                    </div>
                    <div class="widget-body">
                        <img class="pet-img" id="petImage" alt="Загрузка...">
                        <button id="refreshPet">Новое изображение</button>
                    </div>
                </div>
                <!-- Погода СПБ -->
                <div class="widget-card" data-widgetkey="weather">
                    <div class="widget-header">
                        <h4>Погода Санкт‑Петербург</h4>
                        <button class="toggle-widget">−</button>
                    </div>
                    <div class="widget-body">
                        <div class="weather-item" id="weatherTemp">Загрузка погоды...</div>
                        <div class="weather-item" id="weatherFeel"></div>
                        <div class="weather-item" id="weatherWind"></div>
                        <button id="refreshWeather">Обновить погоду</button>
                    </div>
                </div>
                <!-- Курс валют -->
                <div class="widget-card" data-widgetkey="rate">
                    <div class="widget-header">
                        <h4>Курс валют (EUR)</h4>
                        <button class="toggle-widget">−</button>
                    </div>
                    <div class="widget-body">
                        <div class="rate-item" id="rateCny">Загрузка курсов...</div>
                        <div class="rate-item" id="rateUsd"></div>
                        <div class="rate-item" id="rateRub"></div>
                        <button id="refreshRate">Обновить курсы</button>
                    </div>
                </div>
            </div>
        </section>
    </div>
    <div class="overlay" id="overlay">
        <div class="modal">
            <h3 id="modalTitle"></h3>
            <p id="modalText"></p>
            <button class="close-modal">Закрыть</button>
        </div>
    </div>
    <button class="back-top" id="backTop">↑</button>

    <script>
        // переключение темы светлая / тёмная
        const themeBtn = document.getElementById('themeBtn');
        themeBtn.onclick = () => {
            document.documentElement.classList.toggle('dark');
        };

        // модальное окно для проектов
        const overlay = document.getElementById('overlay');
        const modalTitle = document.getElementById('modalTitle');
        const modalText = document.getElementById('modalText');
        const closeBtn = document.querySelector('.close-modal');
        const projectCards = document.querySelectorAll('.project-card');
        projectCards.forEach(card => {
            card.addEventListener('click', () => {
                modalTitle.textContent = card.dataset.name;
                modalText.textContent = card.dataset.desc;
                overlay.style.display = 'flex';
            })
        });
        closeBtn.onclick = () => overlay.style.display = 'none';
        overlay.onclick = (e) => {
            if(e.target === overlay) overlay.style.display = 'none';
        };

        // кнопка "наверх страницы"
        const backTopBtn = document.getElementById('backTop');
        window.addEventListener('scroll', () => {
            backTopBtn.style.display = window.scrollY > 350 ? 'block' : 'none';
        });
        backTopBtn.onclick = () => {
            window.scrollTo({top:0, behavior:'smooth'});
        };

        // сворачивание/разворачивание виджетов + сохранение состояния в localStorage
        document.querySelectorAll('.toggle-widget').forEach(btn=>{
            btn.addEventListener('click',function(){
                const card = this.closest('.widget-card');
                const body = card.querySelector('.widget-body');
                const key = card.dataset.widgetkey;
                body.classList.toggle('collapsed');
                const isCollapsed = body.classList.contains('collapsed');
                this.textContent = isCollapsed ? '+' : '−';
                localStorage.setItem('widget_'+key, isCollapsed);
            })
        });
        // восстановить свернуто/развернуто после перезагрузки страницы
        document.querySelectorAll('.widget-card').forEach(card=>{
            const key = card.dataset.widgetkey;
            const saved = localStorage.getItem('widget_'+key);
            const body = card.querySelector('.widget-body');
            const btn = card.querySelector('.toggle-widget');
            if(saved === "true"){
                body.classList.add('collapsed');
                btn.textContent = "+";
            }
        });

        // ========== Todo‑список дел ==========
        const todoInput = document.getElementById('todoInput');
        const addTodoBtn = document.getElementById('addTodoBtn');
        const todoList = document.getElementById('todoList');
        const clearDoneBtn = document.getElementById('clearDoneBtn');

        function getTodos(){
            return JSON.parse(localStorage.getItem('todos') || '[]');
        }
        function saveTodos(arr){
            localStorage.setItem('todos', JSON.stringify(arr));
        }
        function renderTodos(){
            todoList.innerHTML = '';
            getTodos().forEach((item,idx)=>{
                const li = document.createElement('li');
                li.innerHTML = `
                    <span class="todo-text ${item.done?'todo-done':''}" data-i="${idx}">${item.text}</span>
                    <button class="todo-del" data-i="${idx}">×</button>
                `;
                todoList.appendChild(li);
            })
        }
        // добавить по кнопке
        addTodoBtn.onclick = ()=>{
            const val = todoInput.value.trim();
            if(!val){
                todoInput.placeholder = "Введите текст задачи!";
                return;
            }
            if(val.length>80){
                alert("Задача слишком длинная! Максимум 80 символов.");
                return;
            }
            const arr = getTodos();
            arr.push({text:val, done:false});
            saveTodos(arr);
            todoInput.value='';
            todoInput.placeholder="Добавить задачу...";
            renderTodos();
        };
        // добавить по нажатию Enter
        todoInput.addEventListener('keydown', e=>{
            if(e.key === "Enter") addTodoBtn.click();
        })
        // клик по списку: отметить выполнено / удалить
        todoList.addEventListener('click',e=>{
            const idx = Number(e.target.dataset.i);
            if(isNaN(idx)) return;
            if(e.target.classList.contains('todo-text')){
                const arr = getTodos();
                arr[idx].done = !arr[idx].done;
                saveTodos(arr);
                renderTodos();
            }else if(e.target.classList.contains('todo-del')){
                const arr = getTodos();
                arr.splice(idx,1);
                saveTodos(arr);
                renderTodos();
            }
        });
        clearDoneBtn.onclick = ()=>{
            const arr = getTodos().filter(t=>!t.done);
            saveTodos(arr);
            renderTodos();
        };
        renderTodos();

        // ========== API случайная цитата ==========
        const quoteText = document.getElementById('quoteText');
        const quoteAuthor = document.getElementById('quoteAuthor');
        const refreshQuote = document.getElementById('refreshQuote');
        async function loadQuote(){
            quoteText.textContent = "Загрузка цитаты...";
            quoteAuthor.textContent = "";
            try{
                const res = await fetch("https://api.quotable.io/random");
                if(!res.ok) throw new Error("network");
                const data = await res.json();
                quoteText.textContent = `"${data.content}"`;
                quoteAuthor.textContent = `— ${data.author}`;
            }catch(err){
                quoteText.textContent = "Не удалось загрузить цитату.";
            }
        }
        refreshQuote.onclick = loadQuote;
        loadQuote();

        // ========== API картинка собаки ==========
        const petImage = document.getElementById('petImage');
        const refreshPet = document.getElementById('refreshPet');
        async function loadPetPic(){
            petImage.alt = "Загрузка изображения...";
            try{
                const res = await fetch("https://dog.ceo/api/breeds/image/random");
                if(!res.ok) throw new Error("network");
                const json = await res.json();
                petImage.src = json.message;
            }catch(e){
                petImage.alt = "Ошибка загрузки картинки";
            }
        }
        refreshPet.onclick = loadPetPic;
        loadPetPic();

        // ========== API погода Open‑Meteo Санкт‑Петербург ==========
        const weatherTemp = document.getElementById('weatherTemp');
        const weatherFeel = document.getElementById('weatherFeel');
        const weatherWind = document.getElementById('weatherWind');
        const refreshWeather = document.getElementById('refreshWeather');
        async function loadWeather(){
            weatherTemp.textContent = "Загрузка погоды...";
            weatherFeel.textContent = "";
            weatherWind.textContent = "";
            try{
                const url = "https://api.open‑meteo.com/v1/forecast?latitude=59.94&longitude=30.31&current=temperature_2m,apparent_temperature,wind_speed_10m&timezone=auto";
                const res = await fetch(url);
                if(!res.ok) throw new Error("network");
                const d = await res.json();
                const cur = d.current;
                weatherTemp.textContent = `🌡️ Температура: ${cur.temperature_2m} °C`;
                weatherFeel.textContent = `🤍 Ощущается как: ${cur.apparent_temperature} °C`;
                weatherWind.textContent = `💨 Скорость ветра: ${cur.wind_speed_10m} км/ч`;
            }catch(err){
                weatherTemp.textContent = "Ошибка загрузки погоды";
            }
        }
        refreshWeather.onclick = loadWeather;
        loadWeather();

        // ========== API курс валют EUR ==========
        const rateCny = document.getElementById('rateCny');
        const rateUsd = document.getElementById('rateUsd');
        const rateRub = document.getElementById('rateRub');
        const refreshRate = document.getElementById('refreshRate');
        async function loadRates(){
            rateCny.textContent = "Загрузка курсов...";
            rateUsd.textContent = "";
            rateRub.textContent = "";
            try{
                const res = await fetch("https://api.frankfurter.dev/v2/rates?base=EUR&symbols=CNY,USD,RUB");
                if(!res.ok) throw new Error("network");
                const d = await res.json();
                const r = d.rates;
                rateCny.textContent = `💶 1 EUR = ${r.CNY.toFixed(2)} CNY`;
                rateUsd.textContent = `💶 1 EUR = ${r.USD.toFixed(2)} USD`;
                rateRub.textContent = `💶 1 EUR = ${r.RUB.toFixed(2)} RUB`;
            }catch(err){
                rateCny.textContent = "Ошибка загрузки курсов";
            }
        }
        refreshRate.onclick = loadRates;
        loadRates();
    </script>
</body>
</html>
